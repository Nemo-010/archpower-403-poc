#!/bin/sh
#
# ghcr-fetch - pacman's XferCommand, served from a GHCR mirror of an ArchPOWER
# repository. Nothing here talks to the origin; a real Chromium puts the bytes
# in the registry once a week (mirror/sync.sh), and this reads them back.
#
#   XferCommand = /usr/bin/ghcr-fetch %u %o
#
# The mirrorlist keeps upstream's own Server lines, so %u looks like
# https://repo.archlinuxpower.org/<repo>/<arch>/<file>; only the path is used.
# The artifact is ghcr.io/<NS>/archpower-<repo>:<arch>.
#
# Config: /etc/ghcr-mirror.conf is sourced and may set NS and GHCR_HOST.
set -eu

[ $# -ge 2 ] || { echo "usage: ghcr-fetch <url> <out>" >&2; exit 2; }
url="$1"
out="$2"

NS=""
GHCR_HOST="ghcr.io"
ARCH=""
[ -r /etc/ghcr-mirror.conf ] && . /etc/ghcr-mirror.conf
[ -n "${GHCR_NS:-}" ] && NS="$GHCR_NS"
[ -n "${GHCR_ARCH:-}" ] && ARCH="$GHCR_ARCH"
[ -n "$NS" ] || { echo "ghcr-fetch: NS is not set (see /etc/ghcr-mirror.conf)" >&2; exit 2; }

# /<repo>/<arch>/<file>, however the Server line was spelled.
path="${url#*://}"
path="${path#*/}"
repo="${path%%/*}"
rest="${path#*/}"
arch="${rest%%/*}"
file="${rest#*/}"
[ -n "$repo" ] && [ -n "$arch" ] && [ -n "$file" ] && [ "$file" != "$rest" ] \
  || { echo "ghcr-fetch: cannot parse $url" >&2; exit 2; }

# The `any` repository is mirrored inside the architecture's own artifact, so
# the image names its architecture instead of a second artifact existing.
tag="$arch"
key="$repo/$arch"
if [ "$arch" = "any" ]; then
  [ -n "$ARCH" ] || { echo "ghcr-fetch: an `any` path needs ARCH in /etc/ghcr-mirror.conf" >&2; exit 2; }
  tag="$ARCH"
fi

name="archpower-$repo"
api="https://$GHCR_HOST/v2/$NS/$name"

# Either an anonymous pull (a public mirror, what an image does) or a token
# exchanged for a scoped one; a raw GitHub token is not itself a registry
# bearer and the registry answers 403 if it is sent as one.
scope="scope=repository:$NS/$name:pull&service=$GHCR_HOST"
if [ -n "${GHCR_TOKEN:-}" ]; then
  token="$(curl -fsSL --connect-timeout 10 --max-time 60 \
    -u "${GHCR_USER:-oauth2}:$GHCR_TOKEN" "https://$GHCR_HOST/token?$scope" \
    | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
else
  token="$(curl -fsSL --connect-timeout 10 --max-time 60 "https://$GHCR_HOST/token?$scope" \
    | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
fi
[ -n "$token" ] || { echo "ghcr-fetch: no pull token for $NS/$name" >&2; exit 1; }

manifest="$(curl -fsSL --connect-timeout 10 --max-time 60 \
  -H "Authorization: Bearer $token" \
  -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
  "$api/manifests/$tag")" \
  || { echo "ghcr-fetch: no mirror $name:$tag" >&2; exit 1; }

# The layer whose title is index.tsv, in whichever order the keys appear.
idxdig="$(printf '%s' "$manifest" | sed 's/},{/}\n{/g' \
  | grep '"index.tsv"' \
  | sed -n 's/.*"digest":"\([^"]*\)".*/\1/p' | head -1)"
[ -n "$idxdig" ] || { echo "ghcr-fetch: $name:$tag has no index.tsv" >&2; exit 1; }

index="$(curl -fsSL --connect-timeout 10 --max-time 60 \
  -H "Authorization: Bearer $token" "$api/blobs/$idxdig")" \
  || { echo "ghcr-fetch: cannot read the index" >&2; exit 1; }

sha="$(printf '%s\n' "$index" | awk -F'\t' -v p="$key" -v f="$file" '$1==p && $2==f { print $3; exit }')"
[ -n "$sha" ] || { echo "ghcr-fetch: $key/$file is not mirrored" >&2; exit 1; }

curl -fsSL --connect-timeout 10 --max-time 600 \
  -H "Authorization: Bearer $token" "$api/blobs/sha256:$sha" -o "$out" \
  || { echo "ghcr-fetch: blob $sha failed" >&2; exit 1; }

# The index is the authority; a truncated or swapped blob is refused here too.
got="$(sha256sum "$out" | cut -d' ' -f1)"
[ "$got" = "$sha" ] || { echo "ghcr-fetch: $file sha256 $got != $sha" >&2; exit 1; }
